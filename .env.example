# ============================================
# AI ETL Agent Environment Configuration
# ============================================
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to version control

# ============================================
# LLM Configuration
# ============================================
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# Snowflake Configuration (Optional)
# ============================================
SNOWFLAKE_ACCOUNT=your_snowflake_account
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_DATABASE=your_database_name
SNOWFLAKE_SCHEMA=your_schema_name
SNOWFLAKE_WAREHOUSE=your_warehouse_name

# ============================================
# Databricks Configuration (Optional)
# ============================================
DATABRICKS_HOST=https://your-workspace-url.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_token_here

# ============================================
# SQLite Configuration (Optional)
# ============================================
SQLITE_DB_PATH=./data/local.db

# ============================================
# Application Settings
# ============================================
# Set to true to disable Streamlit's browser opening
STREAMLIT_SERVER_HEADLESS=false

# Maximum file upload size in MB
STREAMLIT_SERVER_MAXUPLOADSIZE=200

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/ai_etl_agent.log

# ============================================
# ChromaDB Configuration (if using external)
# ============================================
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# ============================================
# Development Settings
# ============================================
# Set to true for development/debugging
DEBUG=false
